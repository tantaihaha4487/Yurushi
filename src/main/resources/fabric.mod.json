{
  "schemaVersion": 1,
  "id": "yurushi",
  "version": "${version}",
  "name": "Yurushi",
  "description": "Seamlessly bridge Discord applications to your Minecraft whitelist using interactive Modals and one-click admin approval.",
  "authors": [],
  "contact": {},
  "license": "All-Rights-Reserved",
  "icon": "assets/yurushi/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": [
      "net.thanachot.yurushi.Yurushi"
    ]
  },
  "mixins": [
    "yurushi.mixins.json"
  ],
  "jars": [
    {
      "file": "META-INF/jars/fabric-permissions-api-0.7.0.jar"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=0.155.2+26.1.2",
    "minecraft": "${minecraft_version}",
    "java": ">=25"
  }
}
